# 纸墨朱砂：米色纸张底、深墨色文字、朱砂红选中态和小圆角。
# 注释独占一行，颜色值后面不要追加说明。

# 六组基础状态：内容、标题、默认、悬停、选中、错误。
content-border-color = #c8b99c
content-background-color = #f4eddd
content-text-color = #302c25
header-border-color = #c8b99c
header-background-color = #e6dac2
header-text-color = #302c25
default-border-color = #b5a484
default-background-color = #faf5e9
default-text-color = #302c25
hover-border-color = #a33b30
hover-background-color = #eadeca
hover-text-color = #842d25
active-border-color = #923229
active-background-color = #a33b30
active-text-color = #fff8eb
error-border-color = #ad392f
error-background-color = #fae4db
error-text-color = #8e2e25
border-radius = 2px

# 内容区是浅色纸张底；选中后切换为深红底、浅色文字。
is-dark-background = false
is-dark-active-color = true

# 主按钮和选项卡指示线共用朱砂红。
primary-background-color = #a33b30
primary-text-color = #fff8eb
tabstrip-inkbar-color = #a33b30
focus-shadow-alpha = .2

# 标题栏工具的悬停与选中状态。
header-hover-border-color = #a33b30
header-hover-background-color = #eadeca
header-hover-text-color = #842d25
header-active-border-color = #923229
header-active-background-color = #a33b30
header-active-text-color = #fff8eb

# 首页外框也使用暖色纸张底，使导航与内容区保持一致。
index-header-border-color = #c8b99c
index-header-background-color = #e6dac2
index-header-text-color = #302c25
index-hover-border-color = #a33b30
index-hover-background-color = #eadeca
index-hover-text-color = #842d25
index-active-border-color = #923229
index-active-background-color = #a33b30
index-active-text-color = #fff8eb
